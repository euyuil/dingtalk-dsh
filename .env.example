# 钉钉企业内部应用的凭证，机器人消息接收模式须设置为 Stream。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# 以下模型配置仅供 CLI 独立模式使用；桌面插件使用桌面端的模型与凭证。
DEEPSEEK_API_KEY=
DSH_MODEL=deepseek-flash

# 相对路径均以本程序目录为基准，重启时须保留数据目录。
BRIDGE_DATA_DIR=.data
# 留空时使用数据目录下的 workspace 子目录。
DSH_WORKSPACE=

# 单次任务的最长等待时间（毫秒）。超时不会自动重跑，取消方式由宿主适配器决定。
DSH_RUN_TIMEOUT_MS=300000

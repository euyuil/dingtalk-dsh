{
  "name": "dingtalk-dsh",
  "version": "0.2.14",
  "private": true,
  "type": "module",
  "description": "钉钉机器人与 DeepSeek Harness 的单机文字会话桥接服务",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euyuil/dingtalk-dsh.git"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "pack:plugin": "npm run build && npm pack --ignore-scripts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "dingtalk-stream": "2.1.7-beta.1",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-sdk-client": { "optional": true }
  },
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": { "types": "./dist/plugin.d.ts", "default": "./dist/plugin.js" },
    "./client": "./dist/client.js",
    "./core": { "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" },
    "./compose": { "types": "./dist/compose.d.ts", "default": "./dist/compose.js" },
    "./hosts/sdk": { "types": "./dist/hosts/sdk.d.ts", "default": "./dist/hosts/sdk.js" },
    "./hosts/native": { "types": "./dist/hosts/native.d.ts", "default": "./dist/hosts/native.js" },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["dist", "cordis.patch.yml", "config/plugin.example.yml", ".env.example", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-chat"]
    }
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.2-rc.1": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "@google/genai": false,
    "protobufjs": false
  }
}
